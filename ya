def make_mark(size, pal):
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    m = size * 0.06
    p.setPen(QPen(QColor(pal["accent"]), max(1.5, size * 0.055)))
    p.setBrush(QColor(pal["surface"]))
    p.drawRoundedRect(QRectF(m, m, size - 2 * m, size - 2 * m), size * 0.12, size * 0.12)
    heights = [0.32, 0.62, 1.0, 0.62, 0.32]
    inner = size * 0.52
    bw = size * 0.085
    gap = (inner - 5 * bw) / 4
    x0 = (size - inner) / 2
    cy = size * 0.54
    for i, h in enumerate(heights):
        bh = inner * h
        col = mix(pal["accent"], pal["acc2"], i / 4)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(col))
        p.drawRoundedRect(QRectF(x0 + i * (bw + gap), cy - bh / 2, bw, bh), bw / 2, bw / 2)
    p.setBrush(QColor(pal["danger"]))
    d = size * 0.10
    p.drawEllipse(QRectF(size - m - d * 1.7, m + d * 0.7, d, d))
    p.end()
    return pm


def make_pattern_tile(kind, pal, alpha):
    if kind == "none" or alpha <= 0.01:
        return None
    if kind == "grid":
        t = QPixmap(22, 22); t.fill(Qt.GlobalColor.transparent)
        p = QPainter(t)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(rgba(pal["ink"], int(70 * alpha))))
        p.drawEllipse(QPointF(2, 2), 1.1, 1.1)
        p.end(); return t
    if kind == "scan":
        t = QPixmap(4, 4); t.fill(Qt.GlobalColor.transparent)
        p = QPainter(t)
        p.fillRect(0, 0, 4, 1, QColor(rgba(pal["ink"], int(26 * alpha))))
        p.end(); return t
    if kind == "noise":
        t = QPixmap(96, 96); t.fill(Qt.GlobalColor.transparent)
        p = QPainter(t)
        rng = random.Random(7)
        c = QColor(rgba(pal["ink"], int(40 * alpha)))
        for _ in range(150):
            p.fillRect(rng.randrange(96), rng.randrange(96), 1, 1, c)
        p.end(); return t
    return None


class ElidedLabel(QLabel):
    def paintEvent(self, e):
        p = QPainter(self)
        p.setFont(self.font())
        p.setPen(self.palette().color(QPalette.ColorRole.WindowText))
        txt = self.fontMetrics().elidedText(self.text(), Qt.TextElideMode.ElideRight, self.width())
        p.drawText(self.rect(), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, txt)


class CoverLabel(QWidget):
    def __init__(self, owner, base=44, parent=None):
        super().__init__(parent)
        self.owner = owner
        self.img = None
        self.angle = 0.0
        self.deck = base >= 80
        self.setFixedSize(base, base)

    def set_base(self, px):
        self.setFixedSize(px, px)
        self.update()

    def set_image(self, img):
        self.img = img if (img and not img.isNull()) else None
        self.update()

    def tick(self, playing):
        if (self.deck and self.img and playing and self.owner.cfg["anim"]
                and self.owner.cfg["cover"] == "vinyl"):
            self.angle = (self.angle + 2.4) % 360
            self.update()

    def paintEvent(self, e):
        cfg, pal = self.owner.cfg, self.owner.pal
        w, h = self.width(), self.height()
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        vinyl = self.deck and cfg["cover"] == "vinyl"
        path = QPainterPath()
        if vinyl:
            path.addEllipse(QRectF(1, 1, w - 2, h - 2))
        else:
            r = cfg["radius"] + (4 if self.deck else 0)
            path.addRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), r, r)
        p.setClipPath(path)
        p.fillRect(self.rect(), QColor(pal["overlay"]))
        if self.img:
            iw, ih = self.img.width(), self.img.height()
            sc = max(w / max(1, iw), h / max(1, ih))
            dw, dh = iw * sc, ih * sc
            target = QRectF((w - dw) / 2, (h - dh) / 2, dw, dh)
            if vinyl:
                p.save()
                p.translate(w / 2, h / 2)
                p.rotate(self.angle)
                p.translate(-w / 2, -h / 2)
                p.drawImage(target, self.img)
                p.restore()
                p.setClipping(False)
                p.setClipPath(path)
                p.setBrush(Qt.BrushStyle.NoBrush)
                groove = QColor(rgba(pal["bg"], 120))
                for rr in (0.46, 0.38, 0.30):
                    p.setPen(QPen(groove, 1))
                    p.drawEllipse(QPointF(w / 2, h / 2), w * rr, h * rr)
                p.setPen(QPen(QColor(pal["accent"]), 2))
                p.setBrush(QColor(pal["bg"]))
                p.drawEllipse(QPointF(w / 2, h / 2), w * 0.13, h * 0.13)
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(QColor(pal["accent"]))
                p.drawEllipse(QPointF(w / 2, h / 2), w * 0.035, h * 0.035)
            else:
                p.drawImage(target, self.img)
        else:
            p.setPen(QColor(pal["muted"]))
            f = p.font(); f.setPixelSize(int(h * 0.42)); p.setFont(f)
            p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, "♫")
        p.setClipping(False)
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(QPen(QColor(pal["line"]), max(1, cfg["border"])))
        if vinyl:
            p.drawEllipse(QRectF(1, 1, w - 2, h - 2))
        else:
            r = cfg["radius"] + (4 if self.deck else 0)
            p.drawRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), r, r)
        p.end()


class VizWidget(QWidget):
    def __init__(self, owner, parent=None):
        super().__init__(parent)
        self.owner = owner
        self.n = 36
        self.lv = [0.0] * self.n
        self.pk = [0.0] * self.n
        self.t = 0.0
        self.setMinimumWidth(150)
        self.setFixedHeight(56)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def tick(self, dt, playing, vol):
        self.t += dt
        sens = self.owner.cfg["viz_sens"]
        pump = (0.55 + 0.45 * math.sin(self.t * math.tau * 1.9)) ** 2
        dirty = False
        for i in range(self.n):
            if playing:
                shape = 0.35 + 0.65 * abs(math.sin(self.t * 1.6 + i * 0.37))
                target = clamp((0.18 + 0.82 * shape * (0.55 + 0.45 * random.random()))
                               * pump * sens * vol, 0.0, 1.0)
            else:
                target = 0.0
            k = 0.5 if target > self.lv[i] else 0.12
            nv = self.lv[i] + (target - self.lv[i]) * k
            if abs(nv - self.lv[i]) > 0.002:
                dirty = True
            self.lv[i] = nv
            self.pk[i] = max(self.lv[i], self.pk[i] - 0.018)
        return dirty or playing

    def paintEvent(self, e):
        cfg, pal = self.owner.cfg, self.owner.pal
        style = cfg["viz"]
        if style == "off":
            return
        w, h = self.width(), self.height()
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        glow = cfg["glow"]
        gp = cfg["glow_power"]
        if style == "bars":
            bw = w / self.n
            for i in range(self.n):
                col = QColor(mix(pal["accent"], pal["acc2"], i / (self.n - 1)))
                bh = max(2.0, self.lv[i] * (h - 6))
                x = i * bw
                if glow and bh > 4:
                    p.fillRect(QRectF(x + bw * 0.05, h - bh - 3, bw * 0.9, bh + 3),
                               QColor(rgba(mix(pal["accent"], pal["acc2"], i / (self.n - 1)),
                                           int(46 * gp))))
                p.fillRect(QRectF(x + bw * 0.18, h - bh, bw * 0.64, bh), col)
                py = h - max(2.0, self.pk[i] * (h - 6)) - 2
                p.fillRect(QRectF(x + bw * 0.18, py, bw * 0.64, 2), QColor(pal["ink"]))
        elif style == "wave":
            amp = (sum(self.lv) / self.n) * (h * 0.46)
            mid = h / 2
            for ghost, col, alpha, ph in ((True, pal["acc2"], 110, 1.4), (False, pal["accent"], 255, 0.0)):
                poly = QPolygonF()
                for s in range(65):
                    x = s / 64 * w
                    y = mid + amp * (0.6 * math.sin(self.t * 5 + s * 0.32 + ph)
                                     + 0.4 * math.sin(self.t * 8.7 + s * 0.11 + ph))
                    poly.append(QPointF(x, y))
                pen = QPen(QColor(rgba(col, alpha)), 2)
                p.setPen(pen)
                p.drawPolyline(poly)
            p.setPen(QPen(QColor(rgba(pal["line"], 160)), 1))
            p.drawLine(0, int(mid), w, int(mid))
        elif style == "dots":
            cols, rows = 28, 7
            cw, ch = w / cols, h / rows
            for c in range(cols):
                lvl = self.lv[int(c / cols * self.n)]
                for r in range(rows):
                    lit = (rows - r) / rows <= lvl + 0.04
                    col = mix(pal["accent"], pal["acc2"], r / rows) if lit else pal["line"]
                    a = 255 if lit else 130
                    p.setBrush(QColor(rgba(col, a)))
                    p.setPen(Qt.PenStyle.NoPen)
                    rad = min(cw, ch) * (0.30 if lit else 0.18)
                    p.drawEllipse(QPointF(c * cw + cw / 2, r * ch + ch / 2), rad, rad)
        p.end()


class ClickSlider(QSlider):
    def __init__(self, orient, parent=None):
        super().__init__(orient, parent)

    def _val_at(self, x):
        span = self.maximum() - self.minimum()
        return int(self.minimum() + span * clamp(x / max(1, self.width()), 0, 1))

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton and self.maximum() > self.minimum():
            self.setValue(self._val_at(e.position().x()))
            self.setSliderDown(True)
            self.sliderMoved.emit(self.value())
            e.accept()
            return
        super().mousePressEvent(e)

    def mouseMoveEvent(self, e):
        if self.isSliderDown():
            self.setValue(self._val_at(e.position().x()))
            self.sliderMoved.emit(self.value())
            e.accept()
            return
        super().mouseMoveEvent(e)

    def mouseReleaseEvent(self, e):
        if self.isSliderDown():
            self.setSliderDown(False)
            self.sliderReleased.emit()
            e.accept()
            return
        super().mouseReleaseEvent(e)


