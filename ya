class AuthWorker(QThread):
    code = pyqtSignal(str, str)
    ok = pyqtSignal(str)
    err = pyqtSignal(str)

    def run(self):
        try:
            client = Client()
            token = client.device_auth(on_code=lambda c: self.code.emit(c.verification_url, c.user_code))
            self.ok.emit(token.access_token)
        except Exception as e:
            self.err.emit(str(e))


class ConnectWorker(QThread):
    ok = pyqtSignal(object, object, str)
    err = pyqtSignal(str)

    def __init__(self, token):
        super().__init__()
        self.token = token

    def run(self):
        try:
            client = Client(self.token).init()
            ids = set()
            try:
                likes = client.users_likes_tracks()
                items = likes.tracks if hasattr(likes, "tracks") else likes
                for it in items or []:
                    tid = getattr(it, "id", None)
                    if tid is None and getattr(it, "track", None):
                        tid = it.track.id
                    if tid is not None:
                        ids.add(str(tid))
            except Exception:
                pass
            name = "оператор"
            try:
                me = client.me
                acc = getattr(me, "account", None)
                name = (getattr(acc, "display_name", None) or getattr(acc, "login", None) or name)
            except Exception:
                pass
            self.ok.emit(client, ids, str(name))
        except Exception as e:
            self.err.emit(str(e))


class ApiWorker(QThread):
    result = pyqtSignal(object)
