    def sync_studio(self):
        for key, w in self.ctl.items():
            w.blockSignals(True)
            v = self.cfg[key]
            if isinstance(w, QComboBox):
                i = w.findData(v)
                if i >= 0:
                    w.setCurrentIndex(i)
            elif isinstance(w, QSlider):
                iv = int(round(v * 100)) if isinstance(v, float) else int(v)
                w.setValue(iv)
                if key in self.val_chips:
                    chip, fmt = self.val_chips[key]
                    chip.setText(fmt(iv))
            elif isinstance(w, ToggleKey):
                w.setChecked(bool(v))
                w.refresh()
            w.blockSignals(False)
        self.studio_btn.blockSignals(True)
        self.studio_btn.setChecked(bool(self.cfg["studio_open"]))
        self.studio_btn.blockSignals(False)

    def _sanitize(self, data):
        out = {}
        if not isinstance(data, dict):
            return out
        for k, dv in DEFAULTS.items():
            if k not in data:
                continue
            v = data[k]
            if isinstance(dv, bool):
                out[k] = bool(v)
            elif isinstance(dv, (int, float)):
                try:
                    v = float(v)
                except (TypeError, ValueError):
                    continue
                if k in NUM_RANGE:
                    v = clamp(v, *NUM_RANGE[k])
                out[k] = int(v) if isinstance(dv, int) else v
            elif isinstance(dv, str):
                if not isinstance(v, str):
                    continue
                if k in ENUMS and v not in ENUMS[k]:
                    continue
                if k == "accent" and v and not (len(v) == 7 and v.startswith("#")):
                    continue
                out[k] = v
        return out

    def set_cfg(self, key, val):
        if self.cfg.get(key) == val:
            if key in STRUCT_KEYS:
                self.apply_structure()
            return
        self.cfg[key] = val
        if key in STRUCT_KEYS:
            self.apply_structure()
        self._restyle_timer.start(25)
        self._save_timer.start(500)

    def save_cfg(self):
        self.settings.setValue("cfg_json", json.dumps(self.cfg, ensure_ascii=False))

    def apply_structure(self):
        for w in (self.nav, self.content, self.studio):
            self.body.removeWidget(w)
        if self.cfg["nav_right"]:
            self.body.addWidget(self.content, 1)
            self.body.addWidget(self.studio)
            self.body.addWidget(self.nav)
        else:
            self.body.addWidget(self.nav)
            self.body.addWidget(self.content, 1)
            self.body.addWidget(self.studio)
        self.studio.setVisible(bool(self.cfg["studio_open"]))
        self.studio_btn.blockSignals(True)
        self.studio_btn.setChecked(bool(self.cfg["studio_open"]))
        self.studio_btn.blockSignals(False)

    def restyle(self):
        cfg = self.cfg
        pal = resolve_pal(cfg)
        self.pal = pal
        self.setStyleSheet(build_qss(cfg, pal))

        def S(n):
            return max(9, int(round(n * cfg["scale"])))
        fam = HEADER_FONTS.get(cfg["header_font"], HEADER_FONTS["display"])
        f = QFont(); f.setFamilies([x.strip().strip("'") for x in fam.split(",")])
        f.setPixelSize(S(24)); f.setWeight(QFont.Weight.Black)
        f.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 2.5)
        self.brand_lbl.setFont(f)
        f2 = QFont(f); f2.setPixelSize(S(32)); f2.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 1.5)
        self.h_display.setFont(f2)
        self.off_title.setFont(f2)
        f3 = QFont(); f3.setFamilies([x.strip().strip("'") for x in SANS.split(",")])
        f3.setPixelSize(S(13)); f3.setWeight(QFont.Weight.Bold)
        f3.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 0.8)
        for btn in self.nav_keys.values():
            btn.setFont(f3)

        self._render_section()
        self.mark_lbl.setPixmap(make_mark(30, pal))
        self.off_mark.setPixmap(make_mark(88, pal))
        self.setWindowIcon(QIcon(make_mark(64, pal)))
        self._refresh_leds()

        sig = (cfg["pattern"], round(cfg["pattern_alpha"], 2), cfg["theme"])
        if sig != self._pattern_sig:
            self._pattern_sig = sig
            self._pattern_tile = make_pattern_tile(cfg["pattern"], pal, cfg["pattern_alpha"])

        for fx, base_blur in ((self.fx_play, 26), (self.fx_cover, 30)):
            if cfg["glow"]:
                fx.setBlurRadius(6 + base_blur * cfg["glow_power"])
                fx.setColor(QColor(rgba(pal["accent"], 150)))
                fx.setOffset(0, 0)
            else:
                fx.setBlurRadius(0)
                fx.setColor(QColor(0, 0, 0, 40 if pal["is_light"] else 130))
                fx.setOffset(3, 3)

        cur_acc = cfg["accent"] or THEMES[cfg["theme"]]["acc"]
        for b, col in self.swatches:
            ring = pal["ink"] if col.lower() == cur_acc.lower() else pal["line"]
            b.setStyleSheet(f"QPushButton#swatch {{ background:{col}; border-color:{ring}; }}")

        d = cfg["density"]
        h = int(62 * d)
        for i in range(self.list.count()):
            it = self.list.item(i)
            it.setSizeHint(QSize(0, h))
            w = self.list.itemWidget(it)
            if w and hasattr(w, "set_density"):
                w.set_density(d)

        self.viz.setVisible(cfg["viz"] != "off")
        self.viz.update()
        self.deck_cover.update()
        self.root.update()

