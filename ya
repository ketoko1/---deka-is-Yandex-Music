def hx(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

def rh(rgb):
    return "#{:02x}{:02x}{:02x}".format(*[max(0, min(255, int(v))) for v in rgb])

def lighten(h, f=0.2):
    r, g, b = hx(h)
    return rh((r + (255 - r) * f, g + (255 - g) * f, b + (255 - b) * f))

def darken(h, f=0.3):
    r, g, b = hx(h)
    return rh((r * (1 - f), g * (1 - f), b * (1 - f)))

def mix(h1, h2, t):
    a, b = hx(h1), hx(h2)
    return rh(tuple(a[i] + (b[i] - a[i]) * t for i in range(3)))

def rgba(h, a):
    r, g, b = hx(h)
    return f"rgba({r},{g},{b},{a})"

def contrast_on(h):
    r, g, b = hx(h)
    return "#0B0D08" if (0.299 * r + 0.587 * g + 0.114 * b) > 150 else "#FFFFFF"

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def fmt_ms(ms):
    ms = max(0, int(ms))
    s = ms // 1000
    h, m, sec = s // 3600, (s % 3600) // 60, s % 60
    return f"{h}:{m:02d}:{sec:02d}" if h else f"{m}:{sec:02d}"

def resolve_pal(cfg):
    t = THEMES.get(cfg["theme"], THEMES["phosphor"])
    pal = {k: t[k] for k in ("bg", "surface", "overlay", "ink", "muted", "line",
                             "acc2", "ok", "warn", "danger", "info")}
    acc = cfg["accent"] if cfg["accent"] else t["acc"]
    pal["accent"] = acc
    pal["accent_hover"] = lighten(acc, 0.14)
    pal["accent_dim"] = darken(acc, 0.45)
    pal["on_accent"] = contrast_on(acc)
    pal["is_light"] = cfg["theme"] == "paper"
    return pal


