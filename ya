            f'{self._section_raw}<span style="color:{self.pal["accent"]};">//</span>')

    def set_section(self, raw, sub):
        self._section_raw = raw.upper()
        self._render_section()
        self.sub_lbl.setText(sub)

    def _paint_root(self, e):
        p = QPainter(self.root)
        pal = self.pal
        p.fillRect(self.root.rect(), QColor(pal["bg"]))
        if self._pattern_tile:
            p.drawTiledPixmap(self.root.rect(), self._pattern_tile)
        grad = QLinearGradient(0, 0, 0, self.root.height())
        grad.setColorAt(0.0, QColor(rgba(pal["accent"], 12)))
        grad.setColorAt(0.35, QColor(0, 0, 0, 0))
        grad.setColorAt(1.0, QColor(rgba(pal["acc2"], 8)))
        p.fillRect(self.root.rect(), QBrush(grad))
        p.end()

    def _refresh_leds(self):
        pal = self.pal
        self.led_net.set_state(pal["ok"] if self._net_ok else pal["danger"])
        self.led_buf.set_state(pal["info"] if self._dl_active > 0 else pal["line"])
        playing = self.player.is_playing() if self.player else False
        if playing:
            self.led_rec.set_state(pal["accent"] if (self._blink or not self.cfg["anim"]) else pal["line"])
        elif self.current_track:
            self.led_rec.set_state(pal["warn"])
        else:
            self.led_rec.set_state(pal["line"])

    def toast(self, msg, tone="accent"):
        self.toast_lbl.setText(msg)
        self.toast_lbl.setProperty("tone", tone)
        self.toast_lbl.style().unpolish(self.toast_lbl)
        self.toast_lbl.style().polish(self.toast_lbl)
        self.toast_lbl.adjustSize()
        self._place_toast()
        self.toast_lbl.setVisible(True)
        self.toast_anim.stop()
        if self.cfg["anim"]:
            self.toast_fx.setOpacity(0.0)
            self.toast_anim.setStartValue(0.0); self.toast_anim.setEndValue(1.0)
            self.toast_anim.start()
        else:
            self.toast_fx.setOpacity(1.0)
        self.toast_timer.start(2200)

    def _toast_hide(self):
        if self.cfg["anim"]:
            self.toast_anim.stop()
            self.toast_anim.setStartValue(self.toast_fx.opacity())
            self.toast_anim.setEndValue(0.0)
            try:
                self.toast_anim.finished.disconnect()
            except TypeError:
                pass
            self.toast_anim.finished.connect(lambda: self.toast_lbl.setVisible(False))
            self.toast_anim.start()
        else:
            self.toast_lbl.setVisible(False)

    def _place_toast(self):
        if hasattr(self, "toast_lbl"):
            self.toast_lbl.move(self.width() - self.toast_lbl.width() - 24,
                                self.height() - self.deck.height() - self.toast_lbl.height() - 20)
            self.toast_lbl.raise_()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self._place_toast()

    def api(self, fn, on_ok, on_err=None):
        w = ApiWorker(fn)
        w.result.connect(on_ok)
        w.error.connect(on_err if on_err else (lambda m: self.toast(f"ОШИБКА: {m[:60]}", "danger")))
        WORKERS.add(w)
        w.finished.connect(lambda w=w: WORKERS.discard(w))
        w.start()
        return w

    def on_cover(self, url, img, row):
        IMG_CACHE[url] = img
        while len(IMG_CACHE) > IMG_CACHE_MAX:
            IMG_CACHE.popitem(last=False)
        try:
            row.cover.set_image(img)
        except RuntimeError:
            pass

    def ensure_visible_covers(self, *args):
        vp = self.list.viewport()
        y = 0
        step = max(20, int(62 * self.cfg["density"]))
        while y < vp.height():
            it = self.list.itemAt(0, y)
            if it:
                w = self.list.itemWidget(it)
                if w and hasattr(w, "ensure_cover"):
                    w.ensure_cover()
                y += step
            else:
                y += step

    def load_token(self):
        try:
            with open(TOKEN_FILE, "r", encoding="utf-8") as f:
                self.token = f.read().strip()
        except FileNotFoundError:
            self.token = None
        if self.token:
            self.connect_token(self.token)
        else:
            self.authorize()

    def authorize(self):
        if Client is None:
            self.show_offline("НЕТ БИБЛИОТЕКИ",
                              "Установите yandex-music: pip install yandex-music",
                              cta=False)
            return
        self.show_offline("НАСТРОЙКА ЧАСТОТЫ…",
                          "Откройте ссылку из диалога и введите код с экрана. Волна запустится автоматически.",
                          cta=False)
        if self._auth_dialog:
            try:
                self._auth_dialog.close()
            except RuntimeError:
                pass
        self._auth_dialog = AuthDialog(self)
        self._auth_worker = AuthWorker()
        WORKERS.add(self._auth_worker)
        self._auth_worker.finished.connect(lambda: WORKERS.discard(self._auth_worker))
        self._auth_worker.code.connect(self._auth_dialog.set_code)
        self._auth_worker.ok.connect(self.on_auth_ok)
        self._auth_worker.err.connect(self._auth_dialog.fail)
        self._auth_dialog.rejected.connect(lambda: self.show_offline(
            "НЕТ СИГНАЛА", "Дека не подключена к Яндекс Музыке. Авторизуйтесь по коду — и волна пойдёт сама.", cta=True))
        self._auth_worker.start()
        self._auth_dialog.show()

    def on_auth_ok(self, token):
        self.token = token
        try:
            with open(TOKEN_FILE, "w", encoding="utf-8") as f:
                f.write(token)
        except OSError:
            pass
        if self._auth_dialog:
            self._auth_dialog.done_ok()
        self.connect_token(token)

    def connect_token(self, token):
        self.show_offline("СИНХРОНИЗАЦИЯ…", "Проверяем токен и загружаем лайки.", cta=False)
        self._conn_worker = ConnectWorker(token)
        WORKERS.add(self._conn_worker)
        self._conn_worker.finished.connect(lambda: WORKERS.discard(self._conn_worker))
        self._conn_worker.ok.connect(self.on_connected)
        self._conn_worker.err.connect(self.on_connect_fail)
        self._conn_worker.start()

    def on_connected(self, client, ids, name):
        self.client = client
        self.liked_ids = ids
        self._auth_attempts = 0
        self._net_ok = True
        self.account_lbl.setText(f"ОПЕРАТОР: {name}")
        self._set_online(True)
        self.toast(f"СИГНАЛ ПРИНЯТ · {name}", "ok")
        self.start_wave()

    def on_connect_fail(self, msg):
        self._auth_attempts += 1
        try:
            os.remove(TOKEN_FILE)
        except OSError:
            pass
        if self._auth_attempts < 2:
            self.authorize()
        else:
            self.show_offline("СБОЙ СИНХРОНИЗАЦИИ", msg[:200], cta=True)
            self.toast("НЕ УДАЛОСЬ ПОДКЛЮЧИТЬСЯ", "danger")

    def confirm_logout(self):
        r = QMessageBox.question(self, "Сброс сессии",
                                 "Отключить аккаунт и удалить сохранённый токен?",
                                 QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if r != QMessageBox.StandardButton.Yes:
            return
        self.view_gen += 1
        self.play_gen += 1
        self._wave_gen += 1
        self.player.stop()
        self.client = None
        self.current_track = None
        self.current_queue = []
        self.wave_session = None
        self.wave_seq = []
        self.liked_ids = set()
        self._net_ok = False
        try:
            os.remove(TOKEN_FILE)
        except OSError:
            pass
        self.list.clear()
        self._row_by_id = {}
        self._active_row = None
        self.d_title.setText("ЭФИР ПУСТ")
        self.d_artist.setText("подключите канал")
        self.deck_cover.set_image(None)
        self.codec_chip.setText("—")
        self.cache_chip.setVisible(False)
        self.account_lbl.setText("ОПЕРАТОР: —")
        self._set_online(False)
        self.show_offline("НЕТ СИГНАЛА",
                          "Сессия сброшена. Подключите аккаунт заново, чтобы вернуть волну.", cta=True)
        self.toast("СЕССИЯ СБРОШЕНА", "warn")

    def show_offline(self, title, copy, cta):
        self._section_raw = title
        self.off_title.setText(title)
        self.off_copy.setText(copy)
        self.off_btn.setVisible(cta)
        self.off_btn.setEnabled(cta)
        self.stack.setCurrentIndex(1)

    def _set_online(self, on):
        for w in (*self.nav_keys.values(), self.search, self.find_btn,
                  self.prev_btn, self.play_btn, self.stop_btn, self.next_btn,
                  self.like_btn, self.dislike_btn, self.seek):
            w.setEnabled(on)
        self._refresh_leds()

    def set_nav(self, key):
        for k, btn in self.nav_keys.items():
            btn.setChecked(k == key)

    def _begin_view(self, view, title, sub):
        self.view = view
        self.view_gen += 1
        self.back_btn.setVisible(False)
        self.set_nav(view if view in self.nav_keys else None)
        self.set_section(title, sub)
        self.list.clear()
        self._row_by_id = {}
        self._active_row = None
        self.stack.setCurrentIndex(0)
        return self.view_gen

    def populate_tracks(self, tracks, sub):
        self.current_queue = list(tracks)
        self.queue_index = -1
        self.list.clear()
        self._row_by_id = {}
        h = int(62 * self.cfg["density"])
        for i, tr in enumerate(tracks):
            it = QListWidgetItem(self.list)
            it.setSizeHint(QSize(0, h))
            it.setData(Qt.ItemDataRole.UserRole, ("track", tr, i))
            row = TrackRow(self, tr, i)
            self.list.setItemWidget(it, row)
            self._row_by_id[str(tr.id)] = row
        self.sub_lbl.setText(sub)
        self._mark_active_row()
        QTimer.singleShot(0, self.ensure_visible_covers)

    def start_wave(self):
        if not self.client:
            return
        g = self._begin_view("wave", "МОЯ ВОЛНА", "настройка автопотока…")
        self._wave_gen += 1
        wg = self._wave_gen
        self.wave_seq = []
        self.wave_session = None
        self.d_title.setText("НАСТРОЙКА…")
        self.d_artist.setText("ловим частоту")

        def fetch():
            s = self.client.rotor_session_new(seeds=["user:onyourwave"])
            more = self.client.rotor_session_tracks(s.radio_session_id)
            return more

        def ok(more):
            if g != self.view_gen or wg != self._wave_gen:
                return
            self.wave_session = more
            self.wave_id = str(getattr(more, "radio_session_id", "") or "")
            self.wave_seq = list(more.sequence or [])
            self.set_section("МОЯ ВОЛНА", f"сессия {self.wave_id[-8:] or '—'} · автопоток")
            self.wave_next()

        def err(m):
            if g == self.view_gen:
                self.set_section("МОЯ ВОЛНА", "канал недоступен")
                self.toast(f"ВОЛНА: {m[:60]}", "danger")

        self.api(fetch, ok, err)

    def wave_next(self, auto=False):
        if not self.wave_session or self.view != "wave":
            return
        if self.wave_seq:
            item = self.wave_seq.pop(0)
            tr = getattr(item, "track", None)
            if tr:
                self.request_play(tr)
                self._append_wave_row(tr)
            else:
                self.wave_next(auto)
            return
        wg = self._wave_gen
        sid = self.wave_id

        def fetch():
            return self.client.rotor_session_tracks(sid)

        def ok(more):
            if wg != self._wave_gen or self.view != "wave":
                return
            self.wave_session = more
            self.wave_seq = list(more.sequence or [])
            if self.wave_seq:
                self.wave_next(auto)
            else:
                self.toast("ВОЛНА ПУСТА · повторите", "warn")

        self.api(fetch, ok, lambda m: self.toast(f"ВОЛНА: {m[:60]}", "danger"))

    def _append_wave_row(self, tr):
        it = QListWidgetItem(self.list)
        it.setSizeHint(QSize(0, int(62 * self.cfg["density"])))
        it.setData(Qt.ItemDataRole.UserRole, ("track", tr, -1))
        row = TrackRow(self, tr, -1)
        self.list.setItemWidget(it, row)
        self._row_by_id[str(tr.id)] = row
        row.ensure_cover()
        self.list.scrollToBottom()

    def load_likes(self):
        if not self.client:
            return
        g = self._begin_view("likes", "ЛАЙКИ", "загрузка канала…")
        self.search.clear()

        def fetch():
            likes = self.client.users_likes_tracks()
            if hasattr(likes, "fetch_tracks"):
                try:
                    return list(likes.fetch_tracks() or [])
                except Exception:
                    pass
            out = []
            items = likes.tracks if hasattr(likes, "tracks") else likes
            for it in (items or [])[:200]:
                tr = getattr(it, "track", None)
                if not tr and hasattr(it, "fetch_track"):
                    try:
                        tr = it.fetch_track()
                    except Exception:
                        tr = None
                if tr:
                    out.append(tr)
            return out

        def ok(tracks):
            if g != self.view_gen:
                return
            self.liked_ids = {str(t.id) for t in tracks}
            self.populate_tracks(tracks, f"{len(tracks)} треков · синхронизировано")
            self._sync_like_key()

        self.api(fetch, ok, lambda m: (self.sub_lbl.setText("сбой загрузки"),
                                       self.toast(f"ЛАЙКИ: {m[:60]}", "danger")))

    def load_playlists(self):
        if not self.client:
            return
        g = self._begin_view("playlists", "ПОДБОРКИ", "загрузка канала…")
        self.search.clear()

        def ok(pls):
            if g != self.view_gen:
                return
            self.current_queue = []
            h = int(62 * self.cfg["density"])
            for i, pl in enumerate(pls or []):
                it = QListWidgetItem(self.list)
                it.setSizeHint(QSize(0, h))
                it.setData(Qt.ItemDataRole.UserRole, ("playlist", pl, i))
                self.list.setItemWidget(it, PlaylistRow(self, pl, i))
            self.sub_lbl.setText(f"{len(pls or [])} подборок · двойной клик — открыть")
            QTimer.singleShot(0, self.ensure_visible_covers)

        self.api(lambda: self.client.users_playlists_list(), ok,
                 lambda m: self.toast(f"ПОДБОРКИ: {m[:60]}", "danger"))

    def open_playlist(self, pl):
        g = self._begin_view("playlist", getattr(pl, "title", "подборка"), "загрузка треков…")
        self.set_nav("playlists")
        self.back_btn.setVisible(True)

        def fetch():
            shorts = pl.fetch_tracks()
            tracks = [st.track for st in shorts if getattr(st, "track", None)]
            missing = [st for st in shorts if not getattr(st, "track", None)]
            if missing:
                try:
                    extra = self.client.tracks([st.id for st in missing])
                    tracks.extend(extra or [])
                except Exception:
                    pass
            return tracks

        def ok(tracks):
            if g != self.view_gen:
                return
            self.populate_tracks(tracks, f"{len(tracks)} треков · подборка")

        self.api(fetch, ok, lambda m: self.toast(f"ПОДБОРКА: {m[:60]}", "danger"))

    def do_search(self):
        if not self.client:
            return
        q = self.search.text().strip()
        if not q:
            self.toast("ПУСТОЙ ЗАПРОС", "warn")
            return
        g = self._begin_view("search", "ПОИСК", f"запрос: «{q}» · ищем…")

        def fetch():
            res = self.client.search(q, type_="track")
            return list(res.tracks.results) if res.tracks else []

        def ok(tracks):
            if g != self.view_gen:
                return
            if tracks:
                self.populate_tracks(tracks, f"запрос: «{q}» · {len(tracks)} совпадений")
            else:
                self.sub_lbl.setText(f"запрос: «{q}» · ничего не найдено")

        self.api(fetch, ok, lambda m: self.toast(f"ПОИСК: {m[:60]}", "danger"))

    def on_item_double(self, item):
        data = item.data(Qt.ItemDataRole.UserRole)
        if not data:
            return
        kind, obj, idx = data
        if kind == "playlist":
            self.open_playlist(obj)
        else:
            self.play_row_obj(obj, idx)

    def play_row(self, row):
        self.play_row_obj(row.track, row.idx)

    def play_row_obj(self, tr, idx):
        if self.view != "wave":
            self.queue_index = idx if idx >= 0 else 0
        self.request_play(tr)

    def request_play(self, track):
        self.play_gen += 1
        gen = self.play_gen
        self._advancing = False
        self._dl_active += 1
        self._refresh_leds()
        self.d_title.setText("БУФЕРИЗАЦИЯ…")
        self.d_artist.setText(getattr(track, "title", "")[:80])
        self.cache_chip.setVisible(False)
        key = (str(track.id), self.cfg["quality"])
        cached = self._audio_cache.get(key)
        if cached and os.path.exists(cached[0]):
            self.on_audio_ready(gen, cached[0], cached[1], track, True)
            return
        w = DownloadWorker(gen, track, self.cfg["quality"])
        w.ready.connect(self.on_audio_ready)
        w.fail.connect(self.on_audio_fail)
        WORKERS.add(w)
        w.finished.connect(lambda w=w: WORKERS.discard(w))
        w.start()

    def on_audio_ready(self, gen, path, meta, track, cached):
        self._dl_active = max(0, self._dl_active - 1)
        self._audio_cache[(str(track.id), self.cfg["quality"])] = (path, meta)
        if gen != self.play_gen:
            self._refresh_leds()
            return
        self._media = self.vlc_instance.media_new(path)
        self.player.stop()
        self.player.set_media(self._media)
        if self.player.play() == -1:
            self.toast("VLC НЕ СМОГ ЗАПУСТИТЬ ФАЙЛ", "danger")
        self.current_track = track
        artists = ", ".join(a.name for a in track.artists) if getattr(track, "artists", None) else "—"
        self.d_title.setText(track.title or "без названия")
        self.d_artist.setText(artists)
        self.codec_chip.setText(meta)
        self.cache_chip.setVisible(bool(cached))
        self.play_btn.setText("▮▮")
        self._sync_like_key()
        self._mark_active_row()
        self._load_deck_cover(track)
        self._refresh_leds()

    def on_audio_fail(self, gen, msg):
        self._dl_active = max(0, self._dl_active - 1)
        if gen == self.play_gen:
            self.d_title.setText("СБОЙ ЗАГРУЗКИ")
            self.toast(f"ТРЕК: {msg[:70]}", "danger")
        self._refresh_leds()

    def _load_deck_cover(self, track):
        self.deck_cover.set_image(None)
        if not getattr(track, "cover_uri", None):
            return
        url = "https://" + track.cover_uri.replace("%%", "400x400")
        tid = str(track.id)
        if url in IMG_CACHE:
            self.deck_cover.set_image(IMG_CACHE[url])
            return
        w = ImageWorker(url)

        def done(u, img):
            IMG_CACHE[u] = img
            while len(IMG_CACHE) > IMG_CACHE_MAX:
                IMG_CACHE.popitem(last=False)
            if self.current_track and str(self.current_track.id) == tid:
                self.deck_cover.set_image(img)

        w.done.connect(done)
        WORKERS.add(w)
        w.finished.connect(lambda w=w: WORKERS.discard(w))
        w.start()

    def _mark_active_row(self):
        if self._active_row:
            try:
                self._active_row.set_active(False)
            except RuntimeError:
                pass
            self._active_row = None
        if self.current_track:
            row = self._row_by_id.get(str(self.current_track.id))
            if row:
                try:
                    row.set_active(True)
                    self._active_row = row
                except RuntimeError:
                    pass

    def _sync_like_key(self):
        liked = bool(self.current_track and str(self.current_track.id) in self.liked_ids)
        self.like_btn.setProperty("liked", liked)
        self.like_btn.style().unpolish(self.like_btn)
        self.like_btn.style().polish(self.like_btn)
        self.like_btn.setToolTip("Убрать лайк · L" if liked else "Лайк · L")
        self.dislike_btn.setEnabled(self.view == "wave" and self.current_track is not None)

    def toggle_play(self):
        if not self.client:
            return
        if self.player.is_playing():
            self.player.pause()
            self.play_btn.setText("▶")
        elif self.current_track is not None:
            self.player.play()
            self.play_btn.setText("▮▮")
        elif self.view == "wave":
            self.start_wave()
        elif self.current_queue:
            self.queue_index = 0
            self.request_play(self.current_queue[0])
        self._refresh_leds()

    def stop_playback(self):
        self.player.stop()
        self.play_btn.setText("▶")
        self.seek.setValue(0)
        self.t_cur.setText("0:00")
        self._refresh_leds()

    def next_track(self):
        if self.view == "wave":
            self.feedback("skip")
            self.wave_next()
        else:
            self.next_in_queue()

    def next_in_queue(self):
        if not self.current_queue:
            return
        self.queue_index += 1
        if self.queue_index < len(self.current_queue):
            self.request_play(self.current_queue[self.queue_index])
        else:
            self.queue_index = len(self.current_queue) - 1
            self.stop_playback()
            self.toast("ОЧЕРЕДЬ ЗАВЕРШЕНА", "info")

    def prev_track(self):
        if self.view == "wave" or self.queue_index <= 0:
            if self.current_track:
                self.player.set_time(0)
            return
        self.queue_index -= 1
        self.request_play(self.current_queue[self.queue_index])

    def on_seek(self, value):
        if self.player.is_seekable():
            self.player.set_time(value)
        self.t_cur.setText(fmt_ms(value))

    def on_volume(self, v):
        self.player.audio_set_volume(v)
        self.vol_pct.setText(f"{v}%")
        self.cfg["volume"] = v
        self._save_timer.start(500)

    def toggle_mute(self):
        m = not self.player.audio_get_mute()
        self.player.audio_set_mute(m)
        self.mute_btn.setText("ЗВУК: ВЫКЛ" if m else "ЗВУК: ВКЛ")
        self.deck_mute.setText("○" if m else "◉")
        self.toast("ЗВУК ВЫКЛЮЧЕН" if m else "ЗВУК ВКЛЮЧЕН", "warn" if m else "ok")

    def toggle_like(self):
        if not self.client or not self.current_track:
            return
        tid = str(self.current_track.id)
        was = tid in self.liked_ids
        if was:
            self.liked_ids.discard(tid)
        else:
            self.liked_ids.add(tid)
        self._sync_like_key()
        self.toast("УБРАНО ИЗ ЛАЙКОВ" if was else "ЛАЙК ДОБАВЛЕН", "warn" if was else "ok")
        if self.view == "wave":
            self.feedback("skip" if was else "like")

        def call():
            if was:
                return self.client.users_likes_tracks_remove(tid)
            return self.client.users_likes_tracks_add(tid)

        def err(m):
            if was:
                self.liked_ids.add(tid)
            else:
                self.liked_ids.discard(tid)
            self._sync_like_key()
            self.toast(f"ЛАЙК: {m[:60]}", "danger")

        self.api(call, lambda _: self._after_like(was, tid), err)

    def _after_like(self, was, tid):
        if was and self.view == "likes":
            for i in range(self.list.count()):
                it = self.list.item(i)
                data = it.data(Qt.ItemDataRole.UserRole)
                if data and data[0] == "track" and str(data[1].id) == tid:
                    self.list.takeItem(i)
                    self._row_by_id.pop(tid, None)
                    self.current_queue = [t for t in self.current_queue if str(t.id) != tid]
                    self.sub_lbl.setText(f"{len(self.current_queue)} треков · синхронизировано")
                    break

    def feedback(self, type_):
        if not self.client or not self.wave_session or not self.current_track:
            return
        tid = self.current_track.id

        def call():
            try:
                self.client.rotor_station_feedback(station="user:onyourwave",
                                                   type_=type_, track_id=tid)
            except Exception:
                pass
            return True

        self.api(call, lambda _: None, lambda m: None)

    def send_dislike(self):
        if self.view != "wave" or not self.current_track:
            return
        self.feedback("dislike")
        self.toast("ДИЗЛАЙК · ТРЕК СКРЫТ", "danger")
        self.wave_next()

    def tick_slow(self):
        self._tick_n += 1
        if self._tick_n % 2 == 0:
            self._blink = not self._blink
        if self._tick_n % 4 == 0:
            self.clock_lbl.setText(time.strftime("%H:%M:%S"))
        playing = self.player.is_playing()
        state = self.player.get_state()
        length = self.player.get_length()
        if length > 0:
            pos = self.player.get_time()
            if not self.seek.isSliderDown():
                self.seek.setRange(0, length)
                self.seek.setValue(pos)
                self.t_cur.setText(fmt_ms(pos))
            self.t_dur.setText(fmt_ms(length))
        if vlc is not None and state == vlc.State.Ended and not self._advancing and self.current_track:
            self._advancing = True
            if self.view == "wave":
                self.feedback("trackFinished")
                self.wave_next(auto=True)
            else:
                self.next_in_queue()
        if playing and self.play_btn.text() != "▮▮":
            self.play_btn.setText("▮▮")
        self._refresh_leds()

    def tick_fast(self):
        playing = self.player.is_playing()
        vol = 0.0 if self.player.audio_get_mute() else self.cfg["volume"] / 100
        if self.cfg["viz"] != "off":
            if self.viz.tick(0.033, playing, vol):
                self.viz.update()
        self.deck_cover.tick(playing)

    def pick_accent(self):
        cur = self.cfg["accent"] or THEMES[self.cfg["theme"]]["acc"]
        c = QColorDialog.getColor(QColor(cur), self, "Акцент деки")
        if c.isValid():
            self.set_cfg("accent", c.name().upper())
            self.toast(f"АКЦЕНТ {c.name().upper()}", "accent")

    def randomize(self):
        rng = random.Random()
        upd = {
            "theme": rng.choice(list(THEMES)),
            "accent": rng.choice(ACCENT_SWATCHES + ["", ""]),
            "radius": rng.choice([0, 0, 2, 4, 8, 14, 20]),
            "border": rng.choice([0, 1, 2, 2, 3]),
            "density": round(rng.uniform(0.85, 1.3), 2),
            "scale": round(rng.uniform(0.9, 1.15), 2),
            "pattern": rng.choice(["grid", "scan", "noise", "none"]),
            "pattern_alpha": round(rng.uniform(0.2, 0.9), 2),
            "glow": rng.choice([True, True, False]),
            "glow_power": round(rng.uniform(0.3, 1.0), 2),
            "viz": rng.choice(["bars", "bars", "wave", "dots"]),
            "viz_sens": round(rng.uniform(0.4, 1.0), 2),
            "cover": rng.choice(["square", "vinyl"]),
            "header_font": rng.choice(list(HEADER_FONTS)),
        }
        self.cfg.update(self._sanitize(upd))
        self.sync_studio()
        self.restyle()
        self.save_cfg()
        self.toast("СЛУЧАЙНЫЙ ПРЕСЕТ СОБРАН", "accent")

    def reset_visual(self):
        keep = {k: self.cfg[k] for k in ("volume", "quality")}
        self.cfg = dict(DEFAULTS)
        self.cfg.update(keep)
        self.sync_studio()
        self.apply_structure()
        self.restyle()
        self.save_cfg()
        self.toast("НАСТРОЙКИ СБРОШЕНЫ", "info")

    def export_cfg(self):
        path, _ = QFileDialog.getSaveFileName(self, "Экспорт пресета",
                                              "signal_theme.json", "JSON (*.json)")
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(self.cfg, f, ensure_ascii=False, indent=2)
            self.toast("ПРЕСЕТ СОХРАНЁН В ФАЙЛ", "ok")
        except OSError as e:
            self.toast(f"ЭКСПОРТ: {e}", "danger")

    def import_cfg(self):
        path, _ = QFileDialog.getOpenFileName(self, "Импорт пресета", "", "JSON (*.json)")
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            clean = self._sanitize(data)
            if not clean:
                raise ValueError("в файле нет известных параметров")
            self.cfg.update(clean)
            self.sync_studio()
            self.apply_structure()
            self.restyle()
            self.save_cfg()
            self.player.audio_set_volume(int(self.cfg["volume"]))
            self.vol.setValue(int(self.cfg["volume"]))
            self.toast("ПРЕСЕТ ИМПОРТИРОВАН", "ok")
        except (OSError, ValueError) as e:
            self.toast(f"ИМПОРТ: {e}", "danger")

    def _shortcuts(self):
        def sc(key, fn, ctx=Qt.ShortcutContext.WindowShortcut):
            s = QShortcut(QKeySequence(key), self)
            s.setContext(ctx)
            s.activated.connect(fn)
        sc("Space", self.toggle_play)
        sc("N", self.next_track)
        sc("P", self.prev_track)
        sc("L", self.toggle_like)
        sc("D", self.send_dislike)
        sc("M", self.toggle_mute)
        sc("Ctrl+F", lambda: (self.search.setFocus(), self.search.selectAll()))
        sc("Ctrl+K", lambda: self.set_cfg("studio_open", not self.cfg["studio_open"]))

    def closeEvent(self, e):
        self.save_cfg()
        self.t_slow.stop()
        self.t_fast.stop()
        try:
            self._restyle_timer.stop()
            self._save_timer.stop()
        except Exception:
            pass

        deadline = time.time() + 0.4
        for w in list(WORKERS):
            remaining = int(max(0.0, deadline - time.time()) * 1000)
            if remaining <= 0:
                break
            try:
                w.wait(remaining)
            except Exception:
                pass

        try:
            self.player.stop()
        except Exception:
            pass

        e.accept()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("СИГНАЛ//")
    win = SignalDeck()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
