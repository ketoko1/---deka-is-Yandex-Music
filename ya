        except Exception as e:
            self.error.emit(str(e))


class DownloadWorker(QThread):
    ready = pyqtSignal(int, str, str, object, bool)
    fail = pyqtSignal(int, str)

    def __init__(self, gen, track, quality):
        super().__init__()
        self.gen, self.track, self.quality = gen, track, quality

    def run(self):
        try:
            infos = self.track.get_download_info()
            if not infos:
                raise RuntimeError("нет доступных файлов")
            flac = [i for i in infos if i.codec == "flac"]
            mp3 = sorted([i for i in infos if i.codec == "mp3"],
                         key=lambda i: i.bitrate_in_kbps or 0)
            if self.quality == "lossless" and flac:
                fi = flac[0]
                meta = "FLAC · LOSSLESS"
            elif self.quality == "nq" and mp3:
                fi = mp3[0]
                meta = f"MP3 · {fi.bitrate_in_kbps} KBPS"
            elif mp3:
                hi = [i for i in mp3 if (i.bitrate_in_kbps or 0) >= 320]
                fi = hi[0] if hi else mp3[-1]
                meta = f"MP3 · {fi.bitrate_in_kbps} KBPS"
            elif flac:
                fi = flac[0]; meta = "FLAC · LOSSLESS"
            else:
                fi = infos[0]; meta = (fi.codec or "AUDIO").upper()
            ext = fi.codec or "mp3"
            path = os.path.join(tempfile.gettempdir(),
                                f"signal_{self.track.id}_{self.quality}.{ext}")
            cached = os.path.exists(path) and os.path.getsize(path) > 0
            if not cached:
                fi.download(path)
            self.ready.emit(self.gen, path, meta, self.track, cached)
        except Exception as e:
            self.fail.emit(self.gen, str(e))


class ImageWorker(QThread):
    done = pyqtSignal(str, QImage)

    def __init__(self, url):
        super().__init__()
        self.url = url

    def run(self):
        try:
            req = urllib.request.Request(self.url, headers={"User-Agent": "SignalDeck/1.0"})
            data = urllib.request.urlopen(req, timeout=10).read()
            img = QImage()
            if img.loadFromData(data):
                self.done.emit(self.url, img)
        except Exception:
            pass


