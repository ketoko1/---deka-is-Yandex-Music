    def set_active(self, on):
        pass

    def ensure_cover(self):
        if self._cover_started or not self.cover_url:
            return
        self._cover_started = True
        if self.cover_url in IMG_CACHE:
            self.cover.set_image(IMG_CACHE[self.cover_url])
            return
        w = ImageWorker(self.cover_url)
        w.done.connect(lambda url, img: self.owner.on_cover(url, img, self))
        WORKERS.add(w)
        w.finished.connect(lambda w=w: WORKERS.discard(w))
        w.start()


