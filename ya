class TrackRow(QFrame):
    def __init__(self, owner, track, idx, parent=None):
        super().__init__(parent)
        self.owner = owner
        self.track = track
        self.idx = idx
        self.tid = str(getattr(track, "id", ""))
        self.setObjectName("trackRow")
        self._cover_started = False
        self.cover_url = None
        if getattr(track, "cover_uri", None):
            self.cover_url = "https://" + track.cover_uri.replace("%%", "200x200")

        lay = QHBoxLayout(self)
        lay.setSpacing(12)
        self.idx_lbl = QLabel(f"{idx + 1:02d}" if idx >= 0 else "··")
        self.idx_lbl.setObjectName("rIdx")
        self.idx_lbl.setFixedWidth(26)
        self.cover = CoverLabel(owner, 44)
        title = getattr(track, "title", "без названия")
        artists = ", ".join(a.name for a in track.artists) if getattr(track, "artists", None) else "—"
        self.title_lbl = ElidedLabel(title)
        self.title_lbl.setObjectName("rTitle")
        self.sub_lbl = ElidedLabel(artists)
        self.sub_lbl.setObjectName("rSub")
        tl = QVBoxLayout(); tl.setSpacing(2)
        tl.addWidget(self.title_lbl); tl.addWidget(self.sub_lbl)
        self.active_chip = QLabel("● ЭФИР")
        self.active_chip.setObjectName("chipActive")
        self.active_chip.setVisible(False)
        dur = getattr(track, "duration_ms", None)
        self.dur_lbl = QLabel(fmt_ms(dur) if dur else "--:--")
        self.dur_lbl.setObjectName("rDur")
        self.play_btn = QPushButton("▶")
        self.play_btn.setObjectName("rowPlay")
        self.play_btn.setFixedSize(30, 30)
        self.play_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.play_btn.clicked.connect(lambda: owner.play_row(self))
        lay.addWidget(self.idx_lbl)
        lay.addWidget(self.cover)
        lay.addLayout(tl, 1)
        lay.addWidget(self.active_chip)
        lay.addWidget(self.dur_lbl)
        lay.addWidget(self.play_btn)
        self.set_density(owner.cfg["density"])

    def set_density(self, d):
        v = int(7 * d)
        self.layout().setContentsMargins(10, v, 10, v)
        self.cover.set_base(int(44 * d))

    def set_active(self, on):
        self.active_chip.setVisible(on)
        self.setProperty("active", on)
        self.style().unpolish(self); self.style().polish(self)

    def ensure_cover(self):
        if self._cover_started or not self.cover_url:
            return
        self._cover_started = True
        if self.cover_url in IMG_CACHE:
            self.cover.set_image(IMG_CACHE[self.cover_url])
            return
        w = ImageWorker(self.cover_url)
        w.done.connect(lambda url, img: self.owner.on_cover(url, img, self))
        WORKERS.add(w)
        w.finished.connect(lambda w=w: WORKERS.discard(w))
        w.start()


